Cell[BoxData[
 RowBox[{
  RowBox[{"G0", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"qx_", ",", " ", "qy_"}], "}"}], ",", " ", "\[Omega]_"}], "]"}], 
  ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "q", "}"}], ",", " ", 
