Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RAB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kx_", ",", "ky_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"rx_", ",", "ry_"}], "}"}], ",", "\[Omega]_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{"\[Omega]", "*", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"kx", "*", "rx"}], "+", 
          RowBox[{"ky", "*", "ry"}]}], ")"}]}], "]"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", "VF"}], ")"}], "^", "2"}]}], "*", "I", "*", 
     RowBox[{"HankelH1", "[", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Omega]", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"rx", "^", "2"}], "+", 
            RowBox[{"ry", "^", "2"}]}], "]"}]}], ")"}], "/", "VF"}]}], 
      "]"}]}], ")"}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.9337643218868923`*^9, 3.9337643502219563`*^9}, {
