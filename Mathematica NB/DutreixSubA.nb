           RowBox[{"VF", "*", "\[Xi]", "*", "q", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], "*", "\[Xi]", "*", "\[Theta]q"}], "]"}]}], 
           ",", " ", 
           RowBox[{"-", "\[Omega]"}]}], "}"}]}], "}"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
