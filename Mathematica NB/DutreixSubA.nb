         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "\[Omega]"}], ",", " ", 
           RowBox[{"VF", "*", "\[Xi]", "*", "q", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", "*", "\[Xi]", "*", "\[Theta]q"}], "]"}]}]}], "}"}], 
